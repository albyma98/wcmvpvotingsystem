# Copia questo file in `.env` e personalizza i valori prima del deploy.
# Secret utilizzato per firmare i voti generati dal backend.
VOTE_SECRET=modifica-questa-stringa

# Parametri per generare un amministratore iniziale al primo avvio.
# Imposta a "false" per disabilitare la creazione automatica.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
# Inserisci l'hash SHA-256 della password scelta (vedi README per dettagli).
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ADMIN_ROLE=superadmin

# Imposta l'URL di base usato dalla webapp per chiamare le API.
# Lascia il valore predefinito "/api" se utilizzi il reverse proxy incluso in nginx.
VITE_API_BASE_URL=/api

# Twilio Verify (OTP SMS)
ACCOUNT_SID=
AUTH_TOKEN=
VERIFY_SERVICE_SID=

# Modulo AI LLM (backend only)
# Questo è il file da usare se avvii il progetto con Docker Compose.
# Abilita/disabilita il modulo AI per upsell BAR e popup in-app.
CFG_AI_ENABLED=false

# Provider LLM usato dal backend Go.
# Esempio OpenAI compatibile: https://api.openai.com/v1
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Parametri operativi del servizio AI lato backend.
CFG_AI_REQUESTTIMEOUT=4s
CFG_AI_CACHETTL=90s
CFG_AI_MAXPOPUPSSESSION=3
CFG_AI_POPUPCOOLDOWN=8m
