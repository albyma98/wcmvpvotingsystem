# Copia questo file in `.env` e personalizza i valori prima del deploy.
# Secret utilizzato per firmare i voti generati dal backend.
VOTE_SECRET=modifica-questa-stringa

# Parametri per generare un amministratore iniziale al primo avvio.
# Imposta a "false" per disabilitare la creazione automatica.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
# Inserisci l'hash SHA-256 della password scelta (vedi README per dettagli).
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ADMIN_ROLE=superadmin

# Imposta l'URL di base usato dalla webapp per chiamare le API.
# Lascia il valore predefinito "/api" se utilizzi il reverse proxy incluso in nginx.
VITE_API_BASE_URL=/api

# PostHog Project API Key (frontend, EU host: https://eu.i.posthog.com)
# Ottienila da PostHog → Project Settings → Project API Key.
VITE_POSTHOG_KEY=

# URL HTTPS del CSS che dichiara @font-face per ENDURA con un webfont con licenza.
# Senza URL, ENDURA resta visibile ma disabilitato nel CMS.
VITE_CLUB_ENDURA_STYLESHEET=

# Domini personalizzati ClubHub: hostname del server e, facoltativamente,
# tutti gli IP pubblici ammessi (IPv4/IPv6 separati da virgola).
# Senza IP espliciti, la verifica usa gli indirizzi DNS del target.
CLUB_DOMAIN_TARGET=mvp.wearingcash.it
CLUB_DOMAIN_TARGET_IPS=
# Altri hostname della piattaforma che non possono essere assegnati ai club.
CLUB_DOMAIN_RESERVED_HOSTS=

# Twilio Verify (OTP SMS)
ACCOUNT_SID=
AUTH_TOKEN=
VERIFY_SERVICE_SID=

# Twilio WhatsApp: mittente condiviso. Il Template SID dei risultati e i
# destinatari sono configurati per società nella dashboard amministratore.
WHATSAPP_MESSAGING_SERVICE_ID=
# Template opzionale già usato per avvisare il singolo tifoso vincitore.
CONTENT_TEMPLATE_WINNER_SID=
